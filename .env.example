# === Firebase / Firestore ===
# Opción A (recomendado en producción - Render, Heroku, etc):
# Pega el contenido COMPLETO del archivo JSON de la cuenta de servicio en una sola línea.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# Opción B (recomendado en local): apunta a la ruta del archivo JSON descargado de Firebase
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Opción C (más sencillo en local): simplemente coloca el archivo serviceAccountKey.json
# en la raíz del proyecto y db.js lo cargará automáticamente.

PORT=3000
NODE_ENV=production
